# Kasa Health — example settings. Copy to .env and fill in the values you need.
# Never commit .env.

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# DATA_DIR=backend/data

# --- LLM providers (set at least one; tried in LLM_ORDER) ---
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
XAI_FALLBACK_MODEL=grok-4.3
GEMINI_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
GROQ_API_KEY=
LLM_ORDER=grok,gemini,openai,qwen,grok-fallback,groq

# --- Khaya AI speech and translation (https://developer.khaya.ai) ---
KHAYA_ASR_KEY=
KHAYA_TTS_KEY=
KHAYA_TRANSLATE_KEY=

# --- Hugging Face (thumbs-down corrections) ---
HF_TOKEN=
HF_REPO=

# --- Google Forms sync (formResponse URLs; leave empty to skip) ---
SURVEY_FORM_URL=
RATINGS_FORM_URL=

# --- Alert emails: set RESEND_API_KEY or the SMTP_* values ---
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Security ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5000
